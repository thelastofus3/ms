FROM nvidia/cuda:12.1.1-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-venv python3-pip git curl ca-certificates \
    build-essential ninja-build libgl1 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/runtime/env/bin:/usr/local/cuda/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 TORCH_CUDA_ARCH_LIST=7.5 MAX_JOBS=2 \
    HF_HOME=/runtime/cache/hf TORCH_HOME=/runtime/cache/torch \
    U2NET_HOME=/runtime/cache/rembg PYTHONPATH=/opt/lhmpp:/service
WORKDIR /opt/lhmpp
