# Copy to .env and set a unique password (12–1024 characters).
ROOM_ADMIN_USERNAME=admin
ROOM_ADMIN_PASSWORD=

# Required: standard Base64 encoding of at least 32 cryptographically random bytes.
# There is no default signing secret. See docs/guides/authentication-and-ply-import.md.
ROOM_JWT_SECRET=

# Optional overrides for local room services.
ROOM_BROWSER_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Compose defaults to trusting only its web service for authentication client IPs.
# Native API defaults to no proxy trust; opt in loopback when using local Vite.
# ROOM_AUTH_TRUSTED_PROXIES=127.0.0.1,::1
# ROOM_DATABASE_PASSWORD=replace-with-a-local-database-password
# ROOM_S3_ACCESS_KEY=replace-with-a-local-access-key
# ROOM_S3_SECRET_KEY=replace-with-a-local-secret-key

# Default managed room-object allowance for each account; administrators may override it.
# Includes retained staging, private snapshots, scene outputs, logs and alignment frames.
# Database, avatar/photo storage, GPU scratch and object-store internal overhead are separate.
ROOM_ACCOUNT_STORAGE_GIB=20
ROOM_ACCOUNT_PENDING_UPLOADS=3
ROOM_ACCOUNT_ACTIVE_JOBS=2
# New unattached API upload sessions expire after this many hours.
ROOM_UPLOAD_TTL_HOURS=24
